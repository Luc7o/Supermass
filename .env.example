# Copia este archivo como .env o define estas variables en tu hosting
FLASK_ENV=production
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
ADMIN_PASSWORD=pon-aqui-la-clave-del-panel
# Cadena de conexión de Neon (Dashboard > Connect). Usa la versión "pooled" si despliegas en Vercel.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Opcional: subdominio del panel (solo en producción) ---
# ADMIN_HOST=admin.tudominio.com

# --- Opcional: reporte semanal por correo ---
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" (16 letras)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
# Clave para que solo Vercel pueda disparar el envío automático (Vercel la manda sola como "Bearer")
CRON_SECRET=pon-aqui-otra-clave-larga-y-aleatoria
